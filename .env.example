# Copy to .env and fill in. NEVER commit the real .env file.

# --- LLM providers (the default setup uses both) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only have ONE key? Force every agent onto a single model, e.g.:
# LLM_OVERRIDE=anthropic:claude-sonnet-5
# LLM_OVERRIDE=openai:gpt-4o

# Per-agent models (defaults shown; format provider:model)
# MODEL_SUPERVISOR=anthropic:claude-sonnet-5
# MODEL_RESEARCH=anthropic:claude-sonnet-5
# MODEL_ANALYST=openai:gpt-4o
# MODEL_WRITER=openai:gpt-4o
# MODEL_REVIEWER=anthropic:claude-sonnet-5

# --- Tools ---
TAVILY_API_KEY=                     # web search - free key at https://tavily.com
# HTTP_ALLOWED_HOSTS=api.github.com,en.wikipedia.org   # hosts the http_get tool may call (https only)

# --- Behaviour ---
# MAX_REVISIONS=2                   # automatic writer<->reviewer revision rounds before escalating to a human
# MAX_AGENT_STEPS=6                 # tool-call steps per agent

# --- Running outside Docker (docker-compose sets these itself) ---
# DATABASE_URL=postgresql+psycopg://orchestrai:orchestrai@localhost:5432/orchestrai
# ANALYST_DATABASE_URL=postgresql+psycopg://analyst_ro:analyst_ro@localhost:5432/orchestrai
# REDIS_URL=redis://localhost:6379/0
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# API_URL=http://localhost:8000
